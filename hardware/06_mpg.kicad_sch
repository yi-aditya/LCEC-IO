	(text "CA-IS3742LN: reverse channels 3 and 4 carry A and B to PB4 / PB5 (default output low). Forward channel 1 carries the relay output enable; channel 2 is spare, input tied low."
		(exclude_from_sim no)
		(at 12.7 236.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
