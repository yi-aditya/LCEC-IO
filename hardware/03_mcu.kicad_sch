	(text "51 signals used (pin map in docs/plan.md), PH1 is a test pad, the 30 pins of ports D and E are free for future use (no-connect flags).  Firmware: HSE bypass, PLLM 25 / PLLN 336 / PLLP 2 = 168 MHz, IWDG enabled in option bytes."
		(exclude_from_sim no)
		(at 12.7 16.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0334b69c-28cf-59a0-b46c-3cf6cafde085")
	)
	(text "USART2: 1 TX (PA2), 2 RX (PA3), 3 GND"
		(exclude_from_sim no)
		(at 327.66 179.07 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "054eed66-5b57-596c-9b9e-ba1cf90fee60")
	)
	(text "VDDA / VREF+"
		(exclude_from_sim no)
		(at 45.72 189.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2b10fd55-27da-5b34-9aa4-b4468dfc6535")
	)
	(text "U301 power: 100 nF beside each VDD pin and VBAT, 4.7 uF bulk, VDDA through a ferrite, 2.2 uF on each VCAP"
		(exclude_from_sim no)
		(at 12.7 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "4f9bbea8-391f-596e-9a48-6dfd24a1395c")
	)
	(text "SWD (Cortex 10-pin): 1 VTref, 2 SWDIO, 3/5/9 GND,"
		(exclude_from_sim no)
		(at 327.66 120.65 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "710af64a-b1b0-5010-8a35-628bf27c7d22")
	)
	(text "Test points: SPI1 (LAN9252), SPI2 (DAC), relay OE, analog clamp, MPG A/B and the spare pin PH1"
		(exclude_from_sim no)
		(at 25.4 232.41 0)
		(effects
