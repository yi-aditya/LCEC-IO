  (fp_rect (start -4.6 -4.6) (end 4.6 4.6) (layer "F.CrtYd") (width 0.05))
  (pad "1" thru_hole circle (at -2.5 -3.505 0) (size 3.2 3.2) (drill 1.85) (layers *.Cu *.Mask))
  (pad "1" thru_hole circle (at 2.5 -3.505 0) (size 3.2 3.2) (drill 1.85) (layers *.Cu *.Mask))
  (pad "1" thru_hole circle (at -2.5 3.505 0) (size 3.2 3.2) (drill 1.85) (layers *.Cu *.Mask))
  (pad "1" thru_hole circle (at 2.5 3.505 0) (size 3.2 3.2) (drill 1.85) (layers *.Cu *.Mask))
